// Copy this file to Secrets.xcconfig. Never commit the copied file.
// Escape the URL's double slash so xcconfig does not parse it as a comment.
POCO_BACKEND = supabase
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
// Optional: Auth UI完成前にdevelopment policyでCreator機能を試す場合のみ指定します。
POCO_DEVELOPMENT_USER_ID =
